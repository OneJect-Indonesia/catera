    {
        "id": "b5df0778ad25d66f",
        "type": "function",
        "z": "dc27f64fc3788b32",
        "name": "availability checking",
        "func": "if (msg.payload.length === 0) {\n    msg.status = 'not registered';\n    msg.message = 'Belum Terdaftar';\n    msg.name = \" \";\n} else {\n    const record = msg.payload[0];\n    msg.name = record.name ? record.name.trim() : \" \";\n    \n    if (record.group !== msg.group) {\n        msg.status = 'wrong group';\n        msg.message = 'Salah Antrean';\n        msg.record = record;\n        \n    } else if (record.is_active !== true) {\n        msg.status = 'inactive';\n        msg.message = 'Tidak Aktif';\n        \n    } else if (record.quota <= 0) {\n        msg.status = 'no quota';\n        msg.message = 'Kuota Habis';\n        \n    } else {\n        msg.status = 'authorized';\n        msg.message = 'Silahkan Ambil'; \n        msg.record = record;\n    }\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1500,
        "y": 340,
