    {
        "id": "264db2d97f78f3cb",
        "type": "postgresql",
        "z": "dc27f64fc3788b32",
        "name": "query matched uid",
        "query": "SELECT \n    a.id,\n    TRIM(CONCAT(u.first_name, ' ', u.last_name)) AS name,\n    g.nama_group AS \"group\",\n    (u.status = 'active') AS is_active,\n    a.quota\nFROM catera.authorizeds a\nLEFT JOIN portal_application.md_users u ON a.user_id = u.id\nLEFT JOIN catera.md_groups g ON a.group_id = g.id\nWHERE a.uuid = $1\nLIMIT 1;",
        "postgreSQLConfig": "9b9ef201f0807003",
        "split": false,
        "rowsPerMsg": 1,
        "outputs": 1,
        "x": 1230,
